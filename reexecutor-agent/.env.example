BACKEND_URL=http://localhost:3001
REEXECUTOR_SECRET_KEY=
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
ESCROW_GATE_CONTRACT_ID=
POLL_INTERVAL_MS=3000

# How long a retrieval target may stay unreachable before this worker votes
# mismatch on it (capped at half the submission's challenge window).
RETRIEVAL_RETRY_BUDGET_S=120
# An endpoint this worker must be able to reach anyway. If it cannot, an
# unreachable retrieval target is blamed on this host's network and no vote
# is cast. Defaults to SOROBAN_RPC_URL.
# CONNECTIVITY_CHECK_URL=
