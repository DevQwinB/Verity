# Backend configuration for running outside Docker (pnpm dev creates
# backend/.env from the dev deployment on first run). Every variable is
# validated at start-up; see src/config/env.ts for defaults and the rest.

# Real Stellar testnet config — no mocked endpoints.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
ESCROW_GATE_CONTRACT_ID=
ZK_VERIFIER_REGISTRY_CONTRACT_ID=
BOND_ASSET_CONTRACT_ID=
DEPLOYMENT_NAME=testnet

DATABASE_URL=postgres://verity:verity@localhost:5433/verity

# Verity's own signing key for keeper-driven calls (finalize, resolve,
# release locks). Never a user's key — users sign their own transactions.
KEEPER_SECRET_KEY=
# Signs SEP-10 sign-in challenges. Optional locally (falls back to the keeper
# key); set it on any deployment other people use.
# SEP10_SIGNING_SECRET=

# At least 32 characters: openssl rand -hex 32
JWT_SECRET=
WEB_AUTH_DOMAIN=localhost:3001
HOME_DOMAIN=localhost:3001
PUBLIC_SCHEME=http
PORT=3001

ARTIFACT_STORAGE_DIR=./.artifacts

# Exactly one backend process may run the indexer and keeper.
RUN_WORKERS=true
# true only behind a reverse proxy you control.
TRUST_PROXY=false
