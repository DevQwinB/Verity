# Real Stellar testnet config — no mocked endpoints.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
ESCROW_GATE_CONTRACT_ID=
ZK_VERIFIER_REGISTRY_CONTRACT_ID=
BOND_ASSET_CONTRACT_ID=

DATABASE_URL=postgres://verity:verity@localhost:5433/verity

# Verity's own signing key for admin/keeper-driven calls (finalize sweeps,
# slash execution). Never a user's key — users sign their own submit/challenge
# transactions client-side.
KEEPER_SECRET_KEY=

JWT_SECRET=
WEB_AUTH_DOMAIN=localhost:3001
HOME_DOMAIN=localhost:3001
PORT=3001

ARTIFACT_STORAGE_DIR=./.artifacts
