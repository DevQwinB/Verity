# Verity frontend environment configuration.
# Copy this file to frontend/.env.local for local development with `next dev`.
# Note: Next.js automatically loads .env.local; frontend/.env.local is gitignored.

# Runtime (server-side only):
# URL of the Verity backend API service used by server-side reads and the /api/* proxy.
# Defaults to http://127.0.0.1:3001 in src/lib/config.ts (uses 127.0.0.1 rather than localhost
# because Node resolves localhost to IPv6 ::1 first while the backend only binds IPv4).
# In docker-compose.yml, this is set to http://backend:3001.
BACKEND_URL=http://127.0.0.1:3001

# Build time:
# Stellar network passphrase for Freighter wallet signing.
# Because Next.js inlines NEXT_PUBLIC_* variables into the client bundle at build time,
# this value is fixed when the frontend bundle or Docker image is built, not when it starts.
# In frontend/Dockerfile, this is declared as a build ARG and docker-compose.yml passes
# NETWORK_PASSPHRASE during the build step.
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
