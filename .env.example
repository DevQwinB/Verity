# Root env file consumed by docker-compose.yml / docker-compose.dev.yml.
# Copy to .env and fill in the secret values yourself — never commit .env.
#
# Contract IDs below are the real, already-deployed testnet values from
# deployments/testnet.json (public information, safe to keep as defaults).
ESCROW_GATE_CONTRACT_ID=CDC642RZOEWWDS3GOF7QSPTMVUOYIZ5MDQ4EQQW27KG6XRILGGWR4F4G
ZK_VERIFIER_REGISTRY_CONTRACT_ID=CDYK2EZ4PKL3X5XMORKFGDFQD5V4ITXBW2T224AYS33FB3VSTNZP55CL
BOND_ASSET_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

WEB_AUTH_DOMAIN=localhost:3001
HOME_DOMAIN=localhost:3001

# Secrets — never commit real values here. Get these from your own
# `stellar keys show <alias> --secret` for the identities generated by
# scripts/deploy_testnet.sh / scripts/bootstrap_reexecutors.sh.
KEEPER_SECRET_KEY=
JWT_SECRET=

# Only needed for docker-compose.dev.yml (the 5 bootstrap re-executor agents).
REX1_SECRET_KEY=
REX2_SECRET_KEY=
REX3_SECRET_KEY=
REX4_SECRET_KEY=
REX5_SECRET_KEY=
