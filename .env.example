# Configuration for docker-compose.yml. Copy to .env and fill it in.
# Never commit .env. Full walkthrough: docs/DEPLOY.md.

# --- Which contracts this stack serves -------------------------------------
# From deployments/<name>.json, written by scripts/deploy_testnet.sh.
ESCROW_GATE_CONTRACT_ID=
ZK_VERIFIER_REGISTRY_CONTRACT_ID=
BOND_ASSET_CONTRACT_ID=
# Shown by GET /health so tooling can tell deployments apart.
DEPLOYMENT_NAME=public

# --- Network (defaults are Stellar testnet) --------------------------------
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# --- Public address --------------------------------------------------------
# Host (and port, if any) the backend API is reached on, without a scheme.
# Wallets show this when users sign in.
WEB_AUTH_DOMAIN=
HOME_DOMAIN=
# https behind any real reverse proxy. Sign-in cookies require it.
PUBLIC_SCHEME=https
# Interfaces the containers publish on. Keep 127.0.0.1 and put a reverse
# proxy in front; 0.0.0.0 exposes them directly.
# API_BIND=127.0.0.1
# WEB_BIND=127.0.0.1

# --- Secrets ---------------------------------------------------------------
# Database password, any long random string: openssl rand -hex 24
POSTGRES_PASSWORD=
# Signs session tokens, at least 32 characters: openssl rand -hex 32
JWT_SECRET=
# Pays for keeper transactions (finalize, resolve, release). Needs testnet XLM.
#   stellar keys secret verity-<deployment>-keeper
KEEPER_SECRET_KEY=
# Signs sign-in challenges. Any funded-or-not Stellar secret key, distinct
# from the keeper's:  stellar keys generate verity-<deployment>-sep10 && stellar keys secret verity-<deployment>-sep10
SEP10_SIGNING_SECRET=

# --- Re-executor fleet (docker compose --profile fleet) --------------------
# Staked, approved accounts created by scripts/bootstrap_reexecutors.sh:
#   stellar keys secret verity-<deployment>-rex1   (and rex2..rex5)
REX1_SECRET_KEY=
REX2_SECRET_KEY=
REX3_SECRET_KEY=
REX4_SECRET_KEY=
REX5_SECRET_KEY=
