{
  "name": "verity",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "smoke": "bash scripts/smoke.sh",
    "db:migrate": "pnpm --filter @verity/db migrate",
    "test:contracts": "cd contracts && cargo test",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "db:reset": "pnpm --filter @verity/db reset",
    "lint": "pnpm --filter @verity/frontend lint"
  }
}
