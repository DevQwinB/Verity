# Copy to .env and fill in. Never commit real keys.

# Seller: a funded testnet account that receives the USDC payment AND acts as
# the Verity agent (it signs the bonded submit()). Needs XLM for the bond.
SELLER_SECRET=S...

# Buyer: a funded testnet account with a USDC trustline (Circle faucet).
BUYER_SECRET=S...

# The paid endpoint and the Verity API (pnpm dev runs it on :3001).
SELLER_PORT=4021
VERITY_API=http://localhost:3001
DEPLOYMENT=testnet

# x402 settlement: Coinbase's testnet facilitator, USDC on stellar:testnet.
X402_NETWORK=stellar:testnet
X402_FACILITATOR_URL=https://www.x402.org/facilitator
PRICE_USDC=$0.01

# What the seller declares at stake on EscrowGate, in stroops of the bond
# asset (XLM on this deployment). The bond must be at least
# agent_bond_min_bps of this. See README.md "What is and is not protected".
ESCROW_VALUE_STROOPS=100000
BOND_STROOPS=10000
